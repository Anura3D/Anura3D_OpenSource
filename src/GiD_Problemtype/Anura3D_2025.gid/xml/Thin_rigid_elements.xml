<?xml version="1.0" encoding="utf-8"?><!-- -*- coding: utf-8; mode: SGML -*- -->

<condition n="Thin_rigid_elements" pn="Thin rigid elements" icon="thin_elements" ov="line" ovm="element" help= "Use this condition to assign contact properties">
  <!-- These three are written, in this order, as tokens 2-4 of each row of
       $$START_THIN_RIGID_ELM_PROPERTIES (see scripts/createGOM.tcl). createGOM.tcl reads
       the DEFAULT from the @v attribute, so each one must carry a real v="..."; the old
       att1/v1/value form is <dependencies> syntax and leaves @v undefined, which writes an
       empty token and shifts every remaining column of the 17-column row that
       MeshInfo.FOR reads. -->
  <value n="Name" pn="Name" v="" state="normal" help="Identifier of the rigid body. All line elements sharing this name form one rigid body."/>
  <value n="Thickness" pn="Thickness [m]" v="1.0" state="normal" help="In-plane thickness t of the bar elements. The body area used for its mass and inertia is sum(L_i * t)."/>
  <value n="Rigid_density" pn="Density [kg/m^3]" v="2500.0" state="normal" help="MASS DENSITY of the rigid body in kg/m^3 (e.g. 2500 for concrete) - the same convention as the solid density of a material. This is NOT a unit weight in kN/m^3. The solver forms Mass [Mg] = Density * sum(L_i * t) / 1000, per 1 m out-of-plane in plane strain and per radian in axisymmetry, and echoes the resulting mass and weight of every rigid body in the .LOG file at start-up - check them against your hand calculation."/>
  <value n="Number_of_materials" pn="Number of materials" v="1" values="1,2,3,4" actualize_tree="1">
    <dependencies node="../value[@n='Contact_stiffness_1']" att1="state" v1="normal" value="1"/>
    <dependencies node="../value[@n='Contact_stiffness_1']" att1="state" v1="normal" value="2"/>
    <dependencies node="../value[@n='Contact_stiffness_1']" att1="state" v1="normal" value="3"/>
    <dependencies node="../value[@n='Contact_stiffness_1']" att1="state" v1="normal" value="4"/>
    <dependencies node="../value[@n='Friction_angle_1']" att1="state" v1="normal" value="1"/>
    <dependencies node="../value[@n='Friction_angle_1']" att1="state" v1="normal" value="2"/>
    <dependencies node="../value[@n='Friction_angle_1']" att1="state" v1="normal" value="3"/>
    <dependencies node="../value[@n='Friction_angle_1']" att1="state" v1="normal" value="4"/>

    <dependencies node="../value[@n='Contact_stiffness_2']" att1="state" v1="hidden" value="1"/>
    <dependencies node="../value[@n='Contact_stiffness_2']" att1="state" v1="normal" value="2"/>
    <dependencies node="../value[@n='Contact_stiffness_2']" att1="state" v1="normal" value="3"/>
    <dependencies node="../value[@n='Contact_stiffness_2']" att1="state" v1="normal" value="4"/>
    <dependencies node="../value[@n='Friction_angle_2']" att1="state" v1="hidden" value="1"/>
    <dependencies node="../value[@n='Friction_angle_2']" att1="state" v1="normal" value="2"/>
    <dependencies node="../value[@n='Friction_angle_2']" att1="state" v1="normal" value="3"/>
    <dependencies node="../value[@n='Friction_angle_2']" att1="state" v1="normal" value="4"/>

    <dependencies node="../value[@n='Contact_stiffness_3']" att1="state" v1="hidden" value="1"/>
    <dependencies node="../value[@n='Contact_stiffness_3']" att1="state" v1="hidden" value="2"/>
    <dependencies node="../value[@n='Contact_stiffness_3']" att1="state" v1="normal" value="3"/>
    <dependencies node="../value[@n='Contact_stiffness_3']" att1="state" v1="normal" value="4"/>
    <dependencies node="../value[@n='Friction_angle_3']" att1="state" v1="hidden" value="1"/>
    <dependencies node="../value[@n='Friction_angle_3']" att1="state" v1="hidden" value="2"/>
    <dependencies node="../value[@n='Friction_angle_3']" att1="state" v1="normal" value="3"/>
    <dependencies node="../value[@n='Friction_angle_3']" att1="state" v1="normal" value="4"/>

    <dependencies node="../value[@n='Contact_stiffness_4']" att1="state" v1="hidden" value="1"/>
    <dependencies node="../value[@n='Contact_stiffness_4']" att1="state" v1="hidden" value="2"/>
    <dependencies node="../value[@n='Contact_stiffness_4']" att1="state" v1="hidden" value="3"/>
    <dependencies node="../value[@n='Contact_stiffness_4']" att1="state" v1="normal" value="4"/>
    <dependencies node="../value[@n='Friction_angle_4']" att1="state" v1="hidden" value="1"/>
    <dependencies node="../value[@n='Friction_angle_4']" att1="state" v1="hidden" value="2"/>
    <dependencies node="../value[@n='Friction_angle_4']" att1="state" v1="hidden" value="3"/>
    <dependencies node="../value[@n='Friction_angle_4']" att1="state" v1="normal" value="4"/>

    <dependencies node="../value[@n='Contact_damping_1']" att1="state" v1="normal" value="1"/>
    <dependencies node="../value[@n='Contact_damping_1']" att1="state" v1="normal" value="2"/>
    <dependencies node="../value[@n='Contact_damping_1']" att1="state" v1="normal" value="3"/>
    <dependencies node="../value[@n='Contact_damping_1']" att1="state" v1="normal" value="4"/>

    <dependencies node="../value[@n='Contact_damping_2']" att1="state" v1="hidden" value="1"/>
    <dependencies node="../value[@n='Contact_damping_2']" att1="state" v1="normal" value="2"/>
    <dependencies node="../value[@n='Contact_damping_2']" att1="state" v1="normal" value="3"/>
    <dependencies node="../value[@n='Contact_damping_2']" att1="state" v1="normal" value="4"/>

    <dependencies node="../value[@n='Contact_damping_3']" att1="state" v1="hidden" value="1"/>
    <dependencies node="../value[@n='Contact_damping_3']" att1="state" v1="hidden" value="2"/>
    <dependencies node="../value[@n='Contact_damping_3']" att1="state" v1="normal" value="3"/>
    <dependencies node="../value[@n='Contact_damping_3']" att1="state" v1="normal" value="4"/>

    <dependencies node="../value[@n='Contact_damping_4']" att1="state" v1="hidden" value="1"/>
    <dependencies node="../value[@n='Contact_damping_4']" att1="state" v1="hidden" value="2"/>
    <dependencies node="../value[@n='Contact_damping_4']" att1="state" v1="hidden" value="3"/>
    <dependencies node="../value[@n='Contact_damping_4']" att1="state" v1="normal" value="4"/>
  </value>

  <value n="Contact_stiffness_1" pn="Contact stiffness 1 [kN/m]" v="0.0" state="hidden"/>
  <value n="Contact_stiffness_2" pn="Contact stiffness 2 [kN/m]" v="0.0" state="hidden"/>
  <value n="Contact_stiffness_3" pn="Contact stiffness 3 [kN/m]" v="0.0" state="hidden"/>
  <value n="Contact_stiffness_4" pn="Contact stiffness 4 [kN/m]" v="0.0" state="hidden"/>

  <value n="Friction_angle_1" pn="Friction coefficient [-]" v="0.0" state="hidden"/>
  <value n="Friction_angle_2" pn="Friction coefficient [-]" v="0.0" state="hidden"/>
  <value n="Friction_angle_3" pn="Friction coefficient [-]" v="0.0" state="hidden"/>
  <value n="Friction_angle_4" pn="Friction coefficient [-]" v="0.0" state="hidden"/>

  <!-- Contact damping ratio: fraction of critical damping used for the normal contact
       dashpot, c = zeta * 2 * sqrt(mu_reduced * k_contact). 0 disables damping.
       Values well below 1 are recommended: a high ratio sharply reduces the stable
       explicit time step (dt_crit scales with sqrt(1+z^2)-z). -->
  <value n="Contact_damping_1" pn="Contact damping ratio 1 [-]" v="0.75" state="hidden"/>
  <value n="Contact_damping_2" pn="Contact damping ratio 2 [-]" v="0.75" state="hidden"/>
  <value n="Contact_damping_3" pn="Contact damping ratio 3 [-]" v="0.75" state="hidden"/>
  <value n="Contact_damping_4" pn="Contact damping ratio 4 [-]" v="0.75" state="hidden"/>
</condition>
