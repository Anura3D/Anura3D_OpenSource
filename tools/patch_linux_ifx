#!/usr/bin/env python3

"""Patch Anura3D_OpenSource for a Linux/WSL build with Intel ifx.

The patch is intentionally conservative and transactional:

* every required source layout is checked before any file is written;
* changed files are backed up under .linux-patch-backup/<timestamp>/;
* the script is idempotent and may be run again on an already patched tree;
* a dedicated src/Makefile.linux is generated with debug, ASan, and release modes.

Validated baseline:
    Anura3D/Anura3D_OpenSource
    commit 140247b9c7939e8210cc9f4111256ba094accc1f
    Intel ifx 2026.1.0 on Ubuntu under WSL 2

Linux build limitations:

* Windows DLL-based external soil models are disabled.
* The built-in constitutive models are linked directly and remain available.
* GiD-specific output routines are disabled; VTK/ParaView output is retained.

Usage:
    python3 tools/patch_linux_ifx.py .
    python3 tools/patch_linux_ifx.py /path/to/Anura3D_OpenSource
    python3 tools/patch_linux_ifx.py . --dry-run
"""

from __future__ import annotations

import argparse
import re
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path

